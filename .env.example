# ─── PipeForge environment template ───────────────────────
# Copy to .env and fill in real values. Never commit .env.

APP_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pipeforge
DB_USERNAME=pipeforge
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# Observability
PROMETHEUS_ENABLED=true

# ─── docker-compose host port overrides ───────────────────
# Defaults match Technical Requirements §16. Override only if a port
# is already taken on your machine (e.g. a native Postgres on 5432).
# DB_PORT=5432
# REDIS_PORT=6379
# PGADMIN_PORT=5050
# REDISINSIGHT_PORT=5540
# PROMETHEUS_PORT=9090
DB_NAME=pipeforge
